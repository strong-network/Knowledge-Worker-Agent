# Keep the build context small: most of it would be files the build never
# reads (git history, node_modules, prior build output).
**/.git
**/.gitignore

# Installed by `npm ci` inside the frontend stage; never copied from the context.
**/node_modules

# Local build output and scratch space.
build/
working/

# Generated by the frontend stage and copied in with `COPY --from=frontend`;
# a stale local copy must not shadow it.
cmd/server/html/

# Local runtime state.
*.db
*.db-shm
*.db-wal
